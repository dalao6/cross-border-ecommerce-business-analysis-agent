# ---- LLM 配置（启用后使用 LLM 规划器，OpenAI 兼容接口，如 DeepSeek / Qwen / GLM / SiliconFlow）----
# 不配置 LLM_API_KEY 则自动使用内置规则规划器，全程离线可跑
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ---- 外部信息搜索（行业趋势 / 平台规则 / 政策 / 汇率）----
# mock：使用内置的可信外部信息知识库（离线可用）
# real：调用 LLM 联网搜索（需同时配置 LLM_API_KEY）
EXTERNAL_SEARCH_BACKEND=mock

# ---- 阿里云 OpenSearch（跨境平台 Amazon / Temu / eBay 商品搜索）----
# 申请地址：https://opensearch.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OPENSEARCH_ENDPOINT=https://opensearch-cn-hangzhou.aliyuncs.com
ALIYUN_OPENSEARCH_APP=

# mock：使用内置的 Amazon / Temu / eBay 模拟热销榜
# aliyun_opensearch：调用阿里云 OpenSearch（需先在控制台创建应用并导入商品文档）
MARKETPLACE_SEARCH_BACKEND=mock

# ---- 商品详情抓取（直连 Amazon / Temu / eBay 通常会被反爬拦截）----
# mock：从本地商品库反查（演示用）
# scraperapi：走 ScraperAPI 代理抓取（需 SCRAPER_API_KEY）
# direct：直接 httpx 抓取（仅对受信任小站点有效）
PRODUCT_FETCH_BACKEND=mock
SCRAPER_API_KEY=
FETCH_TIMEOUT=25

# ---- 元数据基础设施（MySQL + Qdrant + ES + Embedding，对齐 shopkeeper-agent）----
# 未启动 Docker 或未安装对应依赖时，服务自动回退到关键词打分方案，不影响离线演示。
MYSQL_META_HOST=localhost
MYSQL_META_PORT=3306
MYSQL_META_USER=didilili
MYSQL_META_PASSWORD=dili123
MYSQL_META_DATABASE=meta

MYSQL_DW_HOST=localhost
MYSQL_DW_PORT=3306
MYSQL_DW_USER=didilili
MYSQL_DW_PASSWORD=dili123
MYSQL_DW_DATABASE=dw

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_EMBEDDING_SIZE=1024

EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

ES_HOST=127.0.0.1
ES_PORT=9200
ES_INDEX_NAME=data_agent

# ---- 召回后端 ----
# auto：运行时检测 Qdrant/ES/Embedding 是否可用，不可用自动回退关键词打分（默认）
# on：强制向量召回（基础设施不可用时召回返回空）
# off：强制关键词打分（完全离线）
VECTOR_RECALL_BACKEND=auto

# ---- Human-in-the-Loop 人工审核 ----
# auto：高风险操作自动放行（离线演示默认，6 个验收案例可跑通）
# manual：高风险操作（执行 SQL / 跨境平台搜索 / 敏感经营数据）前暂停，等待人工确认（经 POST /api/query/confirm 恢复）
HITL_MODE=auto
